+// Return the physical word containing this guest byte, or null on error.
+// Never use copy_buffer here: it rejects unaligned buffers and overwrites
+// entire words on reads, even when the request covers only one byte.
+uint64_t* guest_word(uint64_t* context, uint64_t vaddr) {
+  uint64_t word;
+
+  if (is_virtual_address_valid(vaddr, 1) == 0)
+    return (uint64_t*) 0;
+  if (is_data_stack_heap_address(context, vaddr) == 0)
+    return (uint64_t*) 0;
+
+  word = vaddr - vaddr % WORDSIZE;
+  if (is_virtual_address_valid(word, WORDSIZE) == 0)
+    return (uint64_t*) 0;
+  if (is_data_stack_heap_address(context, word) == 0)
+    return (uint64_t*) 0;
+
+  if (is_virtual_address_mapped(get_pt(context), word) == 0) {
+    if (pavailable() == 0)
+      return (uint64_t*) 0;
+    map_page(context, page_of_virtual_address(word), (uint64_t) palloc());
+    if (is_heap_address(context, word))
+      set_mc_mapped_heap(context, get_mc_mapped_heap(context) + PAGESIZE);
+  }
+  return translate_virtual_to_physical(get_pt(context), word);
+}
