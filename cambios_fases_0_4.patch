+// Serialized by mipster's instruction/trap loop. No other guest context
+// executes while this handler checks and updates the ring.
+void implement_pipe_transfer(uint64_t* context, uint64_t writing) {
+  uint64_t* pipe;
+  uint64_t vbuffer;
+  uint64_t size;
+  uint64_t moved;
+  uint64_t vaddr;
+  uint64_t* word;
+  uint64_t index;
+
+  pipe = lookup_pipe(*(get_regs(context) + REG_A0));
+  if (pipe == (uint64_t*) 0) {
+    syscall_return(context, -1);
+    return;
+  }
+
+  vbuffer = *(get_regs(context) + REG_A1);
+  size = *(get_regs(context) + REG_A2);
+  moved = 0;
+
+  // ID validity precedes zero length; zero length precedes availability.
+  while (moved < size) {
+    if (writing) {
+      if (get_pipe_n(pipe) == PIPE_CAPACITY) {
+        // Phase 4: full returns immediately, including zero progress.
+        syscall_return(context, moved);
+        return;
+      }
+    } else if (get_pipe_n(pipe) == 0) {
+      // Phase 4: empty returns immediately, including zero progress.
+      syscall_return(context, moved);
+      return;
+    }
+
+    vaddr = vbuffer + moved;
+    word = (uint64_t*) 0;
+    // Guard overflow before validating the resulting guest address.
+    if (vaddr >= vbuffer)
+      word = guest_word(context, vaddr);
+    if (word == (uint64_t*) 0) {
+      if (moved == 0)
+        syscall_return(context, -1);
+      else
+        syscall_return(context, moved);
+      return;
+    }
+
+    if (writing) {
+      index = get_pipe_w(pipe);
+      store_character((char*) get_pipe_buffer(pipe), index,
+        load_character((char*) word, vaddr % WORDSIZE));
+      set_pipe_w(pipe, (index + 1) % PIPE_CAPACITY);
+      set_pipe_n(pipe, get_pipe_n(pipe) + 1);
+    } else {
+      index = get_pipe_r(pipe);
+      store_character((char*) word, vaddr % WORDSIZE,
+        load_character((char*) get_pipe_buffer(pipe), index));
+      set_pipe_r(pipe, (index + 1) % PIPE_CAPACITY);
+      set_pipe_n(pipe, get_pipe_n(pipe) - 1);
+    }
+    moved = moved + 1;
+  }
+  syscall_return(context, moved);
+}
+
+void implement_pipe_write(uint64_t* context) {
+  implement_pipe_transfer(context, 1);
+}
+
+void implement_pipe_read(uint64_t* context) {
+  implement_pipe_transfer(context, 0);
+}
