+// Only contexts owned by this kernel are scheduled here. Cached virtual
+// contexts are dispatched explicitly by their parent through switch().
+uint64_t* schedule(uint64_t* from) {
+  uint64_t* candidate;
+
+  candidate = get_next_context(from);
+  if (candidate == (uint64_t*) 0)
+    candidate = used_contexts;
+
+  while (1) {
+    if (get_parent(candidate) == MY_CONTEXT)
+      if (get_status(candidate) == CTX_READY)
+        return candidate;
+
+    if (candidate == from)
+      return (uint64_t*) 0;
+
+    candidate = get_next_context(candidate);
+    if (candidate == (uint64_t*) 0)
+      candidate = used_contexts;
+  }
+}
