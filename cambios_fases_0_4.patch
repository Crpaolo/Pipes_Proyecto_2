+      else if (to_context != from_context)
+        timeout = TIMESLICE;
+      else if (timer == TIMEROFF)
+        timeout = TIMESLICE;
+      else
+        // Syscalls and page faults must not renew a process's time slice.
+        // Otherwise a polling process can starve every other ready process.
+        timeout = timer;
     }
   }
 }
