+uint64_t* lookup_pipe(uint64_t id) {
+  if (pipe_table == (uint64_t*) 0)
+    return (uint64_t*) 0;
+  if (id == 0)
+    return (uint64_t*) 0;
+  if (id >= MAX_PIPES)
+    return (uint64_t*) 0;
+  return (uint64_t*) *(pipe_table + id);
+}
+
+void implement_pipe_create(uint64_t* context) {
+  uint64_t id;
+  uint64_t* pipe;
+
+  if (pipe_table == (uint64_t*) 0)
+    pipe_table = zmalloc(MAX_PIPES * sizeof(uint64_t));
+
+  id = 1;
+  while (id < MAX_PIPES) {
+    if (*(pipe_table + id) == 0) {
+      pipe = zmalloc(9 * sizeof(uint64_t));
+      set_pipe_id(pipe, id);
+      set_pipe_buffer(pipe, zmalloc(round_up(PIPE_CAPACITY, sizeof(uint64_t))));
+      *(pipe_table + id) = (uint64_t) pipe;
+      syscall_return(context, id);
+      return;
+    }
+    id = id + 1;
+  }
+  syscall_return(context, -1);
+}
+
+void implement_pipe_destroy(uint64_t* context) {
+  uint64_t id;
+
+  id = *(get_regs(context) + REG_A0);
+  if (lookup_pipe(id) == (uint64_t*) 0) {
+    syscall_return(context, -1);
+    return;
+  }
+  *(pipe_table + id) = 0;
+  // TODO: reclaim object and buffer when Selfie gains kernel free lists.
+  // Phase 4 has no blocked pipe operations to wake up.
+  syscall_return(context, 0);
+}
